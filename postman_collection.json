      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "stats"]
            },
            "description": "Returns aggregated counts of heat reports, risk breakdown (high, medium, low), cooling centre capacities, available slots, average temperature, and recent reports."
          },
          "response": [
            {
              "name": "200 OK - Aggregated Analytics",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"totalHeatReports\": 8,\n  \"highRiskCount\": 3,\n  \"mediumRiskCount\": 3,\n  \"lowRiskCount\": 2,\n  \"totalCoolingCentres\": 6,\n  \"totalCapacity\": 690,\n  \"totalAvailableSlots\": 395,\n  \"totalOccupiedSlots\": 295,\n  \"averageTemperature\": 36.5\n}"
            }
          ]
        }
      ]
